# انسخ هذا الملف باسم .env وعدّل القيم

# للتطوير المحلي السريع (SQLite) اترك كما هو.
# للإنتاج أو أي نشر عام (Render/Railway/VPS...)، استخدم PostgreSQL مثل:
# DATABASE_URL=postgresql://user:password@host:5432/farm_system
# (سطر واحد فقط — الكود جاهز للتحويل بدون أي تعديل. تنبيه: على المنصات
# المجانية بدون Persistent Disk، ملف SQLite يُصفَّر عند كل إعادة نشر —
# استخدم Postgres المُدار المجاني بنفس المنصة لو تحتاج البيانات تبقى.)
DATABASE_URL=sqlite:///farm_system.db

# ⚠️ إلزامي قبل أي نشر عام يصله أي شخص من الإنترنت: غيّر القيمتين
# التاليتين لقيم حقيقية عشوائية (شاشة "فحص الجاهزية قبل النشر"
# بالإعدادات ترصد بقاءهما على الافتراضي وتحذّرك صراحة).
SECRET_KEY=change-this-to-a-random-secret-key

# بيانات أول حساب مالك يُنشأ تلقائياً عند تشغيل أمر seed
OWNER_NAME=صاحب الحلال
OWNER_PHONE=0500000000
OWNER_PASSWORD=change-me-123

# منفذ السيرفر (بند إضافي، 2026-07-25) — أغلب منصات النشر المجانية تحقنه
# تلقائياً؛ لا تحتاج تعيينه يدوياً إلا بنشر يدوي على VPS خاص بك.
# PORT=8000

# اختياري (بند 25 — المساعد الذكي): المساعد يشتغل بمحرك محلي كامل بدونه.
# لو تبي ترقيته لفهم أسئلة حرة عبر Claude API، فعّل السطرين التاليين
# وثبّت الحزمة (راجع requirements.txt) — بدون أي تعديل كود إضافي.
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-4-8
