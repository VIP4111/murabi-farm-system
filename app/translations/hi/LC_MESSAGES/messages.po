msgid ""
"آخر عمليات الجرد بكل المستودعات — الفرق السالب (هالك) مسجَّل مصروفاً "
"مالياً تلقائياً."
msgstr ""
"सभी गोदामों में नवीनतम गणनाएं — ऋणात्मक अंतर (हानि) स्वचालित रूप से "
"वित्तीय व्यय के रूप में दर्ज होता है।"

#: app/templates/warehouses/inventory_counts_list.html:9
msgid "القسم"
msgstr "अनुभाग"

#: app/templates/warehouses/inventory_counts_list.html:10
msgid "المتوقّع"
msgstr "अपेक्षित"

#: app/templates/warehouses/inventory_counts_list.html:10
msgid "الفعلي"
msgstr "वास्तविक"

#: app/templates/warehouses/inventory_counts_list.html:10
msgid "الفرق"
msgstr "अंतर"

#: app/templates/warehouses/inventory_counts_list.html:11
msgid "قيمة الهالك"
msgstr "हानि मूल्य"

#: app/templates/warehouses/inventory_counts_list.html:29
msgid "ما فيه عمليات جرد مسجَّلة بعد."
msgstr "अभी तक कोई गणना दर्ज नहीं है।"

#: app/templates/warehouses/item_breakdown.html:4
msgid "توزيع المستودعات"
msgstr "गोदाम वितरण"

#: app/templates/warehouses/item_breakdown.html:5
msgid "الإجمالي الحالي:"
msgstr "वर्तमान कुल:"

#: app/templates/warehouses/item_breakdown.html:8
msgid "المستودع"
msgstr "गोदाम"

#: app/templates/warehouses/item_breakdown.html:11
#: app/templates/warehouses/item_breakdown.html:26
#: app/templates/warehouses/item_breakdown.html:30
msgid "افتراضي"
msgstr "डिफ़ॉल्ट"

#: app/templates/warehouses/item_breakdown.html:13
msgid ""
"الإجمالي انخفض تحت المُوزَّع فعلياً بمستودعات مسمّاة — راجع حركات هذا "
"الصنف"
msgstr ""
"कुल राशि नामित गोदामों में वास्तव में वितरित मात्रा से कम हो गई है — इस "
"वस्तु की गतिविधियों की समीक्षा करें"

#: app/templates/warehouses/item_breakdown.html:13
msgid "غير متّسق"
msgstr "असंगत"

#: app/templates/warehouses/item_breakdown.html:37
msgid ""
"التحويل لا يغيّر الإجمالي الحالي إطلاقاً — مجرد نقل مكان تخزين داخل "
"المزرعة."
msgstr ""
"स्थानांतरण वर्तमान कुल को कभी नहीं बदलता — यह केवल फार्म के भीतर भंडारण "
"स्थान बदलना है।"

#: app/templates/warehouses/item_count_form.html:6
msgid "الرصيد المحسوب بالنظام حالياً:"
msgstr "सिस्टम द्वारा गणना किया गया वर्तमान शेष:"

#: app/templates/warehouses/item_count_form.html:9
msgid ""
"اوزن/عدّ الكمية الفعلية بالمستودع واكتبها هنا — النظام يصحّح الرصيد "
"تلقائياً. الزيادة تصحيح مخزون بس، والنقص يُسجَّل \"هالك\" (مصروف غير "
"مباشر يُوزَّع على كل الرؤوس تلقائياً بتقرير تكلفة الرأس الشهرية)."
msgstr ""
"गोदाम में वास्तविक मात्रा तौलें/गिनें और यहां दर्ज करें — सिस्टम स्वचालित"
" रूप से शेष को सही करता है। अधिशेष केवल स्टॉक सुधार है, और कमी को "
"\"हानि\" के रूप में दर्ज किया जाता है (एक अप्रत्यक्ष व्यय जो मासिक "
"प्रति-सिर लागत रिपोर्ट में स्वचालित रूप से सभी सिरों पर वितरित होता है)।"

#: app/templates/warehouses/item_count_form.html:13
