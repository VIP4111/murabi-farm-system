#: app/templates/health/protocol_apply_form.html:7
msgid "الخطوة"
msgstr "ደረጃ"

#: app/templates/health/protocol_apply_form.html:7
#: app/templates/health/protocol_form.html:24
msgid "الدواء"
msgstr "መድሃኒት"

#: app/templates/health/protocol_apply_form.html:20
msgid "تاريخ بداية التطبيق"
msgstr "የመተግበሪያ መጀመሪያ ቀን"

#: app/templates/health/protocol_apply_form.html:23
msgid ""
"تولّد مهمة \"علاج مخطَّط\" واحدة لكل خطوة، مستحقة بتاريخ (بداية التطبيق +"
" يوم الخطوة) — تنتظر مراجعة الدكتور ثم \"تأكيد التنفيذ\" الفعلي (اللي "
"يخصم من الصيدلية ويطبّق فترة السحب تلقائياً)."
msgstr ""
"ለእያንዳንዱ ደረጃ አንድ \"የታቀደ ሕክምና\" ተግባር ይፈጥራል፣ በ(መጀመሪያ ቀን + የደረጃ ቀን) የሚያስፈልግ —"
" የዶክተር ግምገማ ከዚያም ትክክለኛ \"የማስፈጸም ማረጋገጫ\" (ከፋርማሲ የሚቀንስ እና በራስ-ሰር የመውጫ ጊዜን "
"የሚተገብር) ይጠብቃል።"

