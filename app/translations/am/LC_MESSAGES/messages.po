#: app/health/health_service.py:25
msgid "حقن عضل (IM)"
msgstr "የጡንቻ ውስጥ መርፌ (IM)"

#: app/health/health_service.py:26
msgid "بعضلات الرقبة الجانبية أو الفخذ الخلفي عند البالغين، بعيداً عن العمود الفقري والأعصاب الكبيرة. دوّر مكان الحقن بين الجانبين لتفادي تندّب متكرر بنفس المكان. إبرة أقصر وأدق للحملان الصغيرة."
msgstr "ለአዋቂዎች በአንገት ጎን ጡንቻዎች ወይም በኋላ ጭን፣ ከአከርካሪ እና ከትላልቅ ነርቮች ርቆ። በተመሳሳይ ቦታ ተደጋጋሚ ጠባሳ ለማስወገድ የመርፌ ቦታን በሁለቱም ጎኖች መካከል ያዙሩ። ለትንንሽ የግልገል በጎች አጭር እና ስስ መርፌ ይጠቀሙ።"

#: app/health/health_service.py:29
msgid "حقن وريدي (IV)"
msgstr "የደም ስር መርፌ (IV)"

#: app/health/health_service.py:30
msgid "عادة بالوريد الوداجي بالرقبة — يحتاج خبرة ودقة عالية، الأصعب والأخطر بين طرق الحقن. يُترك للدكتور أو الممرض المدرَّب تحديداً، مو العامل الميداني بدون إشراف."
msgstr "አብዛኛውን ጊዜ በአንገት የጁጉላር ደም ስር — ከፍተኛ ችሎታ እና ትክክለኛነት ይፈልጋል፣ ከመርፌ ዘዴዎች መካከል በጣም አስቸጋሪው እና አደገኛው። ያለ ክትትል ለሜዳ ሠራተኛ ሳይሆን በተለይ ለዶክተር ወይም የሠለጠነ ነርስ የተተወ ነው።"

#: app/health/health_service.py:33
msgid "حقن تحت الجلد (SC)"
msgstr "ከቆዳ በታች መርፌ (SC)"

#: app/health/health_service.py:34
msgid "الطريقة الأكثر أماناً وشيوعاً بالإدخال الميداني اليومي. ارفع الجلد بأصابعك لتشكيل \"خيمة\" (عادة برقبة الحيوان أو خلف الكتف)، أدخل الإبرة بزاوية مائلة (تقريباً 30-45 درجة) بقاعدة الخيمة الجلدية بعيداً عن العضل تحتها، وتأكد إنك تحت الجلد فعلاً (سهولة الحقن بدون مقاومة) قبل الضغط."
msgstr "ለዕለታዊ የሜዳ አጠቃቀም በጣም ደህንነቱ የተጠበቀ እና የተለመደ ዘዴ። ቆዳውን በጣቶችዎ አንስተው \"ድንኳን\" ይፍጠሩ (አብዛኛውን ጊዜ በእንስሳው አንገት ወይም ከትከሻ በስተኋላ)፣ መርፌውን ከስር ካለው ጡንቻ ርቆ በቆዳ ድንኳኑ መሠረት ላይ በማዘንበል ማዕዘን (ወደ 30-45 ዲግሪ) ያስገቡ፣ ከመጫንዎ በፊት በእርግጥ ከቆዳ በታች መሆንዎን ያረጋግጡ (ያለ ተቃውሞ ቀላል መርፌ)።"

#: app/health/health_service.py:37
msgid "فموي"
msgstr "በአፍ"

#: app/health/health_service.py:38
msgid "يُعطى مباشرة بالفم بمحقنة فموية بدون إبرة، بحذر من دخول السائل للرئة (اختناق) — ثبّت رأس الحيوان بزاوية معتدلة، مو مائلة للخلف بشدة، وأعطِ الجرعة ببطء."
msgstr "ያለ መርፌ በአፍ ውስጥ በቀጥታ በአፍ መርፌ ይሰጣል፣ ፈሳሹ ወደ ሳንባ እንዳይገባ (መታፈን) ተጠንቀቁ — የእንስሳውን ጭንቅላት በመጠነኛ ማዕዘን ያዙ፣ በጣም ወደ ኋላ ያልተዘነበለ፣ እና መጠኑን በዝግታ ይስጡ።"

#: app/health/health_service.py:41
msgid "موضعي"
msgstr "በቦታው"

#: app/health/health_service.py:42
msgid "يُوضَع مباشرة على سطح الجلد بالمكان المحدَّد (عادة خط الظهر) حسب تعليمات ملصق المنتج — تجنّب الجلد المجروح أو الملتهب."
msgstr "እንደ ምርቱ መለያ መመሪያ በተወሰነው ቦታ (አብዛኛውን ጊዜ የጀርባ መስመር) በቀጥታ በቆዳ ላይ ይደረጋል — የቆሰለ ወይም ያበጠ ቆዳን ያስወግዱ።"

#: app/health/health_service.py:45
msgid "رذاذ/استنشاق"
msgstr "ስፕሬይ/መተንፈስ"

#: app/health/health_service.py:46
msgid "يُستخدم عادة لعلاجات تنفسية جماعية بمساحة محدودة التهوية مؤقتاً، حسب تعليمات جهاز الرذاذ المستخدم — تأكد من تهوية المكان بعد انتهاء المدة الموصى بها."
msgstr "አብዛኛውን ጊዜ ለቡድን የመተንፈሻ አካላት ሕክምናዎች ጊዜያዊ ውስን አየር ማናፈሻ ባለው ቦታ ውስጥ ጥቅም ላይ ይውላል፣ በሚጠቀሙት የስፕሬይ መሣሪያ መመሪያ መሠረት — የተመከረው ጊዜ ካለቀ በኋላ ቦታው አየር መተንፈሱን ያረጋግጡ።"

#: app/health/health_service.py:62
msgid "لقاح/تحصين"
msgstr "ክትባት"

#: app/health/health_service.py:63
msgid "يُعطى وقائياً قبل التعرّض للمرض لبناء مناعة الجسم ضده — ما يُستخدم لعلاج مرض قائم فعلاً. يحتاج عادة جرعة تنشيطية بعد مدة معيّنة (مدة الحماية) لاستمرار الوقاية."
msgstr "በሽታ ከመጋለጡ በፊት የሰውነትን በሽታ የመከላከል አቅም ለመገንባት በመከላከል ይሰጣል — ለነባር በሽታ ሕክምና ጥቅም ላይ አይውልም። መከላከልን ለመቀጠል አብዛኛውን ጊዜ ከተወሰነ ጊዜ በኋላ (የመከላከያ ጊዜ) ማጠናከሪያ መጠን ይፈልጋል።"

#: app/health/health_service.py:66
msgid "مضاد حيوي"
msgstr "አንቲባዮቲክ"

#: app/health/health_service.py:67
msgid "يُستخدم لعلاج عدوى بكتيرية قائمة فعلاً، بعد تشخيص الدكتور — له عادة فترة سحب قبل بيع/حلب الحيوان. ما يُجدي مع الفيروسات."
msgstr "በዶክተር ምርመራ በኋላ ነባር የባክቴሪያ ኢንፌክሽንን ለማከም ጥቅም ላይ ይውላል — እንስሳውን ከመሸጥ/ከማለብ በፊት አብዛኛውን ጊዜ የመውጫ ጊዜ አለው። በቫይረሶች ላይ አይሠራም።"

#: app/health/health_service.py:70
msgid "مضاد طفيليات/ديدان"
msgstr "የተውሳክ/ትል መድሃኒት"

#: app/health/health_service.py:71
msgid "يُعطى دورياً حسب برنامج المزرعة لمكافحة الطفيليات الداخلية/الخارجية — التكرار المتقارب جداً بدون داعٍ قد يقلل فعاليته لاحقاً (نفس حارس منع التكرار خلال 30 يوماً بالنظام)."
msgstr "የውስጥ/የውጭ ተውሳኮችን ለመቆጣጠር እንደ እርሻው መርሃ ግብር በየጊዜው ይሰጣል — ያለ ምክንያት በጣም ተጠጋግቶ መደጋገም በኋላ ውጤታማነቱን ሊቀንስ ይችላል (በስርዓቱ ውስጥ ተመሳሳይ የ30 ቀን መደጋገም መከላከያ)።"

#: app/health/health_service.py:74
msgid "فيتامينات ومكمّلات"
msgstr "ቫይታሚኖች እና ተጨማሪዎች"

#: app/health/health_service.py:75
msgid "يدعم التغذية العامة أو يسدّ نقصاً غذائياً محدداً (مثل السيلينيوم) — مو علاجاً لمرض قائم، ومعظمها بدون فترة سحب."
msgstr "አጠቃላይ አመጋገብን ይደግፋል ወይም የተወሰነ የአመጋገብ እጥረትን ይሞላል (እንደ ሴሌኒየም) — ለነባር በሽታ ሕክምና አይደለም፣ አብዛኞቹም ያለ መውጫ ጊዜ ናቸው።"

#: app/health/health_service.py:78
msgid "مطهرات وعلاجات موضعية"
msgstr "ማጽጃዎች እና የቦታ ሕክምናዎች"

#: app/health/health_service.py:79
msgid "يُستخدم على سطح الجلد/الجرح مباشرة (تطهير، تندّب، طفيليات خارجية موضعية) — عادة أقل امتصاصاً جهازياً من الحقن/الفموي."
msgstr "በቀጥታ በቆዳ/ቁስል ላይ ጥቅም ላይ ይውላል (ማጽዳት፣ ጠባሳ መፈወስ፣ የቦታ ውጫዊ ተውሳኮች) — አብዛኛውን ጊዜ ከመርፌ/በአፍ ያነሰ ስልታዊ መምጠጥ አለው።"

#: app/health/health_service.py:83
msgid "فئة عامة لما لا يندرج تحت الفئات الأخرى — راجع ملاحظة الجرعة المرجعية المكتوبة على الدواء نفسه."
msgstr "ከሌሎች ምድቦች ስር ላልሆነው አጠቃላይ ምድብ — በመድሃኒቱ ላይ የተጻፈውን የማጣቀሻ መጠን ማስታወሻ ይመልከቱ።"

