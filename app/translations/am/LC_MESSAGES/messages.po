msgid "حقن عضل (IM)"
msgstr "የጡንቻ ውስጥ መርፌ (IM)"

#: app/health/health_service.py:83
msgid ""
"بعضلات الرقبة الجانبية أو الفخذ الخلفي عند البالغين، بعيداً عن العمود "
"الفقري والأعصاب الكبيرة. دوّر مكان الحقن بين الجانبين لتفادي تندّب متكرر "
"بنفس المكان. إبرة أقصر وأدق للحملان الصغيرة."
msgstr ""
"ለአዋቂዎች በአንገት ጎን ጡንቻዎች ወይም በኋላ ጭን፣ ከአከርካሪ እና ከትላልቅ ነርቮች ርቆ። በተመሳሳይ ቦታ "
"ተደጋጋሚ ጠባሳ ለማስወገድ የመርፌ ቦታን በሁለቱም ጎኖች መካከል ያዙሩ። ለትንንሽ የግልገል በጎች አጭር እና ስስ "
"መርፌ ይጠቀሙ።"

#: app/health/health_service.py:86
msgid "حقن وريدي (IV)"
msgstr "የደም ስር መርፌ (IV)"

#: app/health/health_service.py:87
msgid ""
"عادة بالوريد الوداجي بالرقبة — يحتاج خبرة ودقة عالية، الأصعب والأخطر بين "
"طرق الحقن. يُترك للدكتور أو الممرض المدرَّب تحديداً، مو العامل الميداني "
"بدون إشراف."
msgstr ""
"አብዛኛውን ጊዜ በአንገት የጁጉላር ደም ስር — ከፍተኛ ችሎታ እና ትክክለኛነት ይፈልጋል፣ ከመርፌ ዘዴዎች መካከል "
"በጣም አስቸጋሪው እና አደገኛው። ያለ ክትትል ለሜዳ ሠራተኛ ሳይሆን በተለይ ለዶክተር ወይም የሠለጠነ ነርስ የተተወ "
"ነው።"

#: app/health/health_service.py:90
msgid "حقن تحت الجلد (SC)"
msgstr "ከቆዳ በታች መርፌ (SC)"

#: app/health/health_service.py:91
msgid ""
"الطريقة الأكثر أماناً وشيوعاً بالإدخال الميداني اليومي. ارفع الجلد "
"بأصابعك لتشكيل \"خيمة\" (عادة برقبة الحيوان أو خلف الكتف)، أدخل الإبرة "
"بزاوية مائلة (تقريباً 30-45 درجة) بقاعدة الخيمة الجلدية بعيداً عن العضل "
"تحتها، وتأكد إنك تحت الجلد فعلاً (سهولة الحقن بدون مقاومة) قبل الضغط."
msgstr ""
"ለዕለታዊ የሜዳ አጠቃቀም በጣም ደህንነቱ የተጠበቀ እና የተለመደ ዘዴ። ቆዳውን በጣቶችዎ አንስተው \"ድንኳን\" "
"ይፍጠሩ (አብዛኛውን ጊዜ በእንስሳው አንገት ወይም ከትከሻ በስተኋላ)፣ መርፌውን ከስር ካለው ጡንቻ ርቆ በቆዳ "
"ድንኳኑ መሠረት ላይ በማዘንበል ማዕዘን (ወደ 30-45 ዲግሪ) ያስገቡ፣ ከመጫንዎ በፊት በእርግጥ ከቆዳ በታች "
"መሆንዎን ያረጋግጡ (ያለ ተቃውሞ ቀላል መርፌ)።"

#: app/health/health_service.py:94
msgid "فموي"
msgstr "በአፍ"

#: app/health/health_service.py:95
msgid ""
"يُعطى مباشرة بالفم بمحقنة فموية بدون إبرة، بحذر من دخول السائل للرئة "
"(اختناق) — ثبّت رأس الحيوان بزاوية معتدلة، مو مائلة للخلف بشدة، وأعطِ "
"الجرعة ببطء."
msgstr ""
"ያለ መርፌ በአፍ ውስጥ በቀጥታ በአፍ መርፌ ይሰጣል፣ ፈሳሹ ወደ ሳንባ እንዳይገባ (መታፈን) ተጠንቀቁ — "
"የእንስሳውን ጭንቅላት በመጠነኛ ማዕዘን ያዙ፣ በጣም ወደ ኋላ ያልተዘነበለ፣ እና መጠኑን በዝግታ ይስጡ።"

#: app/health/health_service.py:98
msgid "موضعي"
msgstr "በቦታው"

#: app/health/health_service.py:99
msgid ""
"يُوضَع مباشرة على سطح الجلد بالمكان المحدَّد (عادة خط الظهر) حسب تعليمات "
"ملصق المنتج — تجنّب الجلد المجروح أو الملتهب."
msgstr ""
"እንደ ምርቱ መለያ መመሪያ በተወሰነው ቦታ (አብዛኛውን ጊዜ የጀርባ መስመር) በቀጥታ በቆዳ ላይ ይደረጋል — የቆሰለ"
" ወይም ያበጠ ቆዳን ያስወግዱ።"

#: app/health/health_service.py:102
msgid "رذاذ/استنشاق"
msgstr "ስፕሬይ/መተንፈስ"

#: app/health/health_service.py:103
msgid ""
"يُستخدم عادة لعلاجات تنفسية جماعية بمساحة محدودة التهوية مؤقتاً، حسب "
"تعليمات جهاز الرذاذ المستخدم — تأكد من تهوية المكان بعد انتهاء المدة "
"الموصى بها."
msgstr ""
"አብዛኛውን ጊዜ ለቡድን የመተንፈሻ አካላት ሕክምናዎች ጊዜያዊ ውስን አየር ማናፈሻ ባለው ቦታ ውስጥ ጥቅም ላይ "
"ይውላል፣ በሚጠቀሙት የስፕሬይ መሣሪያ መመሪያ መሠረት — የተመከረው ጊዜ ካለቀ በኋላ ቦታው አየር መተንፈሱን "
"ያረጋግጡ።"

#: app/health/health_service.py:119
msgid "لقاح/تحصين"
msgstr "ክትባት"

#: app/health/health_service.py:120
msgid ""
"يُعطى وقائياً قبل التعرّض للمرض لبناء مناعة الجسم ضده — ما يُستخدم لعلاج "
"مرض قائم فعلاً. يحتاج عادة جرعة تنشيطية بعد مدة معيّنة (مدة الحماية) "
"لاستمرار الوقاية."
msgstr ""
"በሽታ ከመጋለጡ በፊት የሰውነትን በሽታ የመከላከል አቅም ለመገንባት በመከላከል ይሰጣል — ለነባር በሽታ ሕክምና "
"ጥቅም ላይ አይውልም። መከላከልን ለመቀጠል አብዛኛውን ጊዜ ከተወሰነ ጊዜ በኋላ (የመከላከያ ጊዜ) ማጠናከሪያ መጠን "
"ይፈልጋል።"

#: app/health/health_service.py:123
msgid "مضاد حيوي"
msgstr "አንቲባዮቲክ"

#: app/health/health_service.py:124
msgid ""
"يُستخدم لعلاج عدوى بكتيرية قائمة فعلاً، بعد تشخيص الدكتور — له عادة فترة "
"سحب قبل بيع/حلب الحيوان. ما يُجدي مع الفيروسات."
msgstr ""
"በዶክተር ምርመራ በኋላ ነባር የባክቴሪያ ኢንፌክሽንን ለማከም ጥቅም ላይ ይውላል — እንስሳውን ከመሸጥ/ከማለብ በፊት"
" አብዛኛውን ጊዜ የመውጫ ጊዜ አለው። በቫይረሶች ላይ አይሠራም።"

#: app/health/health_service.py:127
msgid "مضاد طفيليات/ديدان"
msgstr "የተውሳክ/ትል መድሃኒት"

#: app/health/health_service.py:128
msgid ""
"يُعطى دورياً حسب برنامج المزرعة لمكافحة الطفيليات الداخلية/الخارجية — "
"التكرار المتقارب جداً بدون داعٍ قد يقلل فعاليته لاحقاً (نفس حارس منع "
"التكرار خلال 30 يوماً بالنظام)."
msgstr ""
"የውስጥ/የውጭ ተውሳኮችን ለመቆጣጠር እንደ እርሻው መርሃ ግብር በየጊዜው ይሰጣል — ያለ ምክንያት በጣም ተጠጋግቶ "
"መደጋገም በኋላ ውጤታማነቱን ሊቀንስ ይችላል (በስርዓቱ ውስጥ ተመሳሳይ የ30 ቀን መደጋገም መከላከያ)።"

#: app/health/health_service.py:131
msgid "فيتامينات ومكمّلات"
msgstr "ቫይታሚኖች እና ተጨማሪዎች"

#: app/health/health_service.py:132
msgid ""
"يدعم التغذية العامة أو يسدّ نقصاً غذائياً محدداً (مثل السيلينيوم) — مو "
"علاجاً لمرض قائم، ومعظمها بدون فترة سحب."
msgstr ""
"አጠቃላይ አመጋገብን ይደግፋል ወይም የተወሰነ የአመጋገብ እጥረትን ይሞላል (እንደ ሴሌኒየም) — ለነባር በሽታ "
"ሕክምና አይደለም፣ አብዛኞቹም ያለ መውጫ ጊዜ ናቸው።"

#: app/health/health_service.py:135
msgid "مطهرات وعلاجات موضعية"
msgstr "ማጽጃዎች እና የቦታ ሕክምናዎች"

#: app/health/health_service.py:136
msgid ""
"يُستخدم على سطح الجلد/الجرح مباشرة (تطهير، تندّب، طفيليات خارجية موضعية) "
"— عادة أقل امتصاصاً جهازياً من الحقن/الفموي."
msgstr ""
"በቀጥታ በቆዳ/ቁስል ላይ ጥቅም ላይ ይውላል (ማጽዳት፣ ጠባሳ መፈወስ፣ የቦታ ውጫዊ ተውሳኮች) — አብዛኛውን ጊዜ "
"ከመርፌ/በአፍ ያነሰ ስልታዊ መምጠጥ አለው።"

#: app/health/health_service.py:140
msgid ""
"فئة عامة لما لا يندرج تحت الفئات الأخرى — راجع ملاحظة الجرعة المرجعية "
"المكتوبة على الدواء نفسه."
msgstr "ከሌሎች ምድቦች ስር ላልሆነው አጠቃላይ ምድብ — በመድሃኒቱ ላይ የተጻፈውን የማጣቀሻ መጠን ማስታወሻ ይመልከቱ።"

#: app/health/health_service.py:197
msgid "خمول / ضعف عام"
msgstr "ድካም / አጠቃላይ ድካም"

#: app/health/health_service.py:199
msgid ""
"إجراءات أولية لحين وصول الطبيب:\n"
"• افصل الرأس عن باقي القطيع بمكان هادئ ومظلّل، بعيد عن الزحام.\n"
"• وفّر ماء نظيف بمتناوله مباشرة — لا تجبره على الشرب.\n"
"• سجّل الحرارة لو عندك ميزان حرارة بيطري (تحت الذيل) — رقم فعلي يفيد "
"الدكتور كثير.\n"
"• لا تعطِ أي دواء أو حقنة بدون توجيه الدكتور مباشرة.\n"
"• راقب: هل يقف ويمشي طبيعي؟ هل يستجيب لصوتك؟ سجّل أي تغيّر بالوقت."
msgstr ""
"ሐኪሙ እስኪደርስ ድረስ የመጀመሪያ እርምጃዎች:\n"
"• እንስሳውን ከቀሪው መንጋ ለይ፣ ጸጥ ያለ እና ጥላ ባለበት ቦታ፣ ከመጨናነቅ ራቅ ብሎ።\n"
"• ንጹህ ውሃ በቀላሉ በሚደረስበት ቦታ አቅርብ — እንዲጠጣ አታስገድደው።\n"
"• የእንስሳት ሐኪም ቴርሞሜትር ካለዎት ሙቀት ይመዝግቡ (ከጅራት ስር) — እውነተኛ ቁጥር ለሐኪሙ በጣም ይረዳል።\n"
"• ያለ ሐኪሙ ቀጥተኛ መመሪያ ምንም መድሃኒት ወይም መርፌ አትስጥ።\n"
"• ተመልከት: በመደበኛነት ይቆማል እና ይራመዳል? ለድምጽህ ምላሽ ይሰጣል? ማንኛውንም ለውጥ በጊዜ ውስጥ መዝግብ።"

#: app/health/health_service.py:210
msgid "إسهال"
msgstr "ተቅማጥ"

#: app/health/health_service.py:212
msgid ""
"إجراءات أولية لحين وصول الطبيب:\n"
"• اعزل الرأس فوراً — الإسهال ينتقل بسرعة بين رؤوس القطيع.\n"
"• وفّر ماء نظيف بكثرة — خطر الجفاف أعلى خطر بالإسهال، خصوصاً بالصغار.\n"
"• لو الإسهال مدمّى أو لونه غامق جداً أو الرأس صغير العمر (بهمة) = اتصل "
"بالطبيب فوراً، لا تنتظر.\n"
"• لا تعطِ أي مضاد حيوي أو دواء إسهال بدون الطبيب — أغلب حالات الإسهال "
"البسيطة تحتاج فقط سوائل ومراقبة.\n"
"• نظّف المكان اللي كان فيه الرأس قبل ما تدخل رؤوس ثانية."
msgstr ""
"ሐኪሙ እስኪደርስ ድረስ የመጀመሪያ እርምጃዎች:\n"
"• እንስሳውን ወዲያውኑ ለይ — ተቅማጥ በመንጋ ውስጥ በፍጥነት ይሰራጫል።\n"
"• ብዙ ንጹህ ውሃ አቅርብ — ድርቀት በተቅማጥ ትልቁ አደጋ ነው፣ በተለይ በትንንሽ እንስሳት ውስጥ።\n"
"• ተቅማጡ ደም ያለበት ወይም በጣም ጨለማ ቀለም ካለው ወይም እንስሳው ትንሽ (ግልገል) ከሆነ = ወዲያውኑ ሐኪም "
"ደውል፣ አትጠብቅ።\n"
"• ያለ ሐኪም ምንም አንቲባዮቲክ ወይም የተቅማጥ መድሃኒት አትስጥ — አብዛኞቹ ቀላል የተቅማጥ ጉዳዮች ፈሳሽ እና "
"ክትትል ብቻ ያስፈልጋቸዋል።\n"
"• ሌሎች እንስሳት ከማምጣትዎ በፊት እንስሳው የነበረበትን ቦታ አጽዳ።"

#: app/health/health_service.py:223
msgid "امتناع عن الأكل"
msgstr "ምግብ አለመቀበል"

#: app/health/health_service.py:225
msgid ""
"إجراءات أولية لحين وصول الطبيب:\n"
"• تأكد إن العلف والماء متوفرين وبمتناوله فعلاً (مو مشكلة وصول).\n"
"• افحص فمه بلطف لو تقدر — جروح، تورّم، أو رغوة قد تفسّر رفض الأكل.\n"
"• راقب مدة الامتناع — أكثر من يوم كامل بدون أكل (خصوصاً بهمة أو حامل) وضع"
" يستدعي طبيب بلا تأجيل.\n"
"• لا تجبره على الأكل ولا تعطِ منشّط شهية بدون الطبيب.\n"
"• سجّل أي أعراض مصاحبة (خمول، إسهال، حرارة) — تساعد التشخيص كثير."
msgstr ""
"ሐኪሙ እስኪደርስ ድረስ የመጀመሪያ እርምጃዎች:\n"
"• መኖ እና ውሃ ትክክለኛ በሚደረስበት ቦታ መኖራቸውን አረጋግጥ (የመድረስ ችግር አይደለም)።\n"
"• ከቻልክ አፉን በርጋታ ፈትሽ — ቁስሎች፣ እብጠት፣ ወይም አረፋ ምግብ አለመቀበልን ሊያብራሩ ይችላሉ።\n"
"• የመቀበል ጊዜ ርዝማኔን ተመልከት — ከሙሉ ቀን በላይ ያለ ምግብ (በተለይ ግልገል ወይም ነፍሰ ጡር) ያለ "
"መዘግየት ሐኪም ይፈልጋል።\n"
"• እንዲበላ አታስገድደው ወይም ያለ ሐኪም የምግብ ፍላጎት ማነቃቂያ አትስጥ።\n"
"• ማንኛውንም አብሮ ያለ ምልክት (ድካም፣ ተቅማጥ፣ ትኩሳት) መዝግብ — ይህ ምርመራን በጣም ይረዳል።"

#: app/health/health_service.py:236
msgid "تغيّر ملحوظ بالحليب"
msgstr "በወተት ውስጥ የሚታይ ለውጥ"

#: app/health/health_service.py:238
msgid ""
"إجراءات أولية لحين وصول الطبيب:\n"
"• لاحظ التغيّر بدقة: كمية أقل، لون غير طبيعي، رائحة، تكتّل/دم — دوّنها.\n"
"• افحص الضرع بلطف: احمرار، سخونة موضعية، تورّم، ألم عند اللمس = اشتباه "
"التهاب ضرع، يحتاج طبيب قريب.\n"
"• لا توقف الحلب أو الرضاعة الطبيعية إلا بتوجيه الدكتور — التوقف المفاجئ "
"قد يزيد المشكلة.\n"
"• افصل حليب هذا الرأس عن بقية الإنتاج لحين تأكيد سلامته.\n"
"• راجع سجل الولادة الأخيرة — تغيّر الحليب قريب من الولادة أو الفطام "
"غالباً طبيعي، بعيد عنهما يستاهل انتباه أكبر."
msgstr ""
"ሐኪሙ እስኪደርስ ድረስ የመጀመሪያ እርምጃዎች:\n"
"• ለውጡን በትክክል ተመልከት: ያነሰ መጠን፣ ያልተለመደ ቀለም፣ ሽታ፣ እብጠት/ደም — መዝግበው።\n"
"• ጡትን በርጋታ ፈትሽ: መቅላት፣ የአካባቢ ሙቀት፣ እብጠት፣ ሲነካ ህመም = የጡት እብጠት ጥርጣሬ፣ ቅርብ ሐኪም "
"ያስፈልጋል።\n"
"• ያለ ሐኪም መመሪያ ማለብን ወይም ጡት ማጥባትን አታቁም — ድንገተኛ ማቆም ችግሩን ሊያባብሰው ይችላል።\n"
"• ደህንነቱ እስኪረጋገጥ ድረስ የዚህን እንስሳ ወተት ከቀሪው ምርት ለይ።\n"
"• የቅርብ ጊዜ የልደት መዝገብ ይመልከቱ — ከልደት ወይም ከጡት ማስጣል ቅርብ የሆነ የወተት ለውጥ አብዛኛውን ጊዜ "
"የተለመደ ነው፣ ከእነሱ ርቆ የበለጠ ትኩረት ይገባዋል።"

#: app/health/health_service.py:249
msgid "عرج / صعوبة بالمشي"
msgstr "አንካሳ / የመራመድ ችግር"

#: app/health/health_service.py:251
msgid ""
"إجراءات أولية لحين وصول الطبيب:\n"
"• افحص القدم المتأثرة بلطف — جسم غريب، جرح، تورّم، أو حرارة موضعية.\n"
"• أبقِه بمكان جاف ونظيف — الأرضية الموحلة أو المتّسخة تزيد التهاب القدم "
"سوءاً.\n"
"• لا تحاول أي علاج أو تنظيف عميق للجرح بنفسك لو كان عميقاً أو ينزف — "
"انتظر الطبيب.\n"
"• قلّل حركته الإجبارية (لا تنقله مسافات طويلة) لحين الفحص."
msgstr ""
"ሐኪሙ እስኪደርስ ድረስ የመጀመሪያ እርምጃዎች:\n"
"• የተጎዳውን እግር በርጋታ ፈትሽ — የውጭ ነገር፣ ቁስል፣ እብጠት፣ ወይም የአካባቢ ሙቀት።\n"
"• ደረቅ እና ንጹህ ቦታ ውስጥ አቆየው — የጭቃ ወይም የቆሸሸ ወለል የእግር ኢንፌክሽንን ያባብሰዋል።\n"
"• ቁስሉ ጥልቅ ወይም ደም እየፈሰሰ ከሆነ በራስዎ ምንም ጥልቅ ሕክምና ወይም ጽዳት አይሞክሩ — ሐኪሙን ይጠብቁ።\n"
"• እስከሚመረመር ድረስ የግዳጅ እንቅስቃሴውን ይቀንሱ (ረጅም ርቀት አያንቀሳቅሱት)።"

#: app/health/health_service.py:261
msgid "سقوط مفاجئ / تشنّج / عدم قدرة على الوقوف"
msgstr "ድንገተኛ መውደቅ / መንቀጥቀጥ / መቆም አለመቻል"

#: app/health/health_service.py:263
msgid ""
"إجراءات أولية لحين وصول الطبيب — حالة تستدعي اتصال فوري بالطبيب، لا "
"تنتظر:\n"
"• أبعد أي شي حاد أو خطر حوله، وأعطه مساحة — لا تحاول تقييده بالقوة أثناء "
"أي تشنّج.\n"
"• لا تسكب أي شي بفمه (ماء أو دواء) وهو غير واعٍ تماماً — خطر اختناق "
"حقيقي.\n"
"• سجّل وقت بداية الحالة ومدتها لو قدرت — معلومة مهمة جداً للطبيب.\n"
"• اتصل بالطبيب فوراً بالهاتف أيضاً بالتوازي مع رفع هذا البلاغ — هذي حالة "
"لا تنتظر."
msgstr ""
"ሐኪሙ እስኪደርስ ድረስ የመጀመሪያ እርምጃዎች — ይህ ሁኔታ ወዲያውኑ ለሐኪም ስልክ መደወል ይፈልጋል፣ አትጠብቅ:\n"
"• በአካባቢው ያለ ማንኛውንም ስለታም ወይም አደገኛ ነገር አስወግድ፣ እና ቦታ ስጠው — በመንቀጥቀጥ ጊዜ በኃይል "
"ለማሰር አትሞክር።\n"
"• ሙሉ በሙሉ ንቁ ባልሆነበት ጊዜ በአፉ ውስጥ ምንም ነገር (ውሃ ወይም መድሃኒት) አታፍስስ — እውነተኛ የመታፈን "
"አደጋ።\n"
"• ከቻልክ የክስተቱ መጀመሪያ ጊዜ እና ርዝማኔ መዝግብ — ለሐኪሙ በጣም አስፈላጊ መረጃ።\n"
"• ይህን ሪፖርት ከማቅረብ ጎን ለጎን ወዲያውኑ በስልክም ሐኪሙን ደውል — ይህ ሁኔታ አይጠብቅም።"

#: app/health/health_service.py:284
msgid "هزيل جداً"
msgstr "በጣም ቀጭን"

#: app/health/health_service.py:285
msgid ""
"العمود الفقري بارز وحاد جداً تحت اليد، الأضلاع واضحة بوضوح بدون أي غطاء "
"لحمي، ما فيه أي دهن محسوس فوق أو حول الفقرات. حالة طارئة تغذوية — راجع "
"الطبيب."
msgstr ""
"የጀርባ አጥንት ከእጅ በታች በጣም ስለታም እና ጎልቶ የሚታይ ነው፣ የጎድን አጥንቶች ያለ ምንም ስጋ ሽፋን በግልጽ "
"ይታያሉ፣ በአከርካሪው ላይ ወይም አካባቢ ምንም የሚዳሰስ ስብ የለም። የተመጣጠነ ምግብ አደጋ ጊዜ — ሐኪም ያማክሩ።"

#: app/health/health_service.py:288
msgid "هزيل"
msgstr "ቀጭን"

#: app/health/health_service.py:289
msgid ""
"الفقرات القطنية محسوسة بوضوح لكن حوافها أقل حدة من الدرجة 1، الأضلاع تُحس"
" بسهولة عند الضغط الخفيف. يحتاج تحسين خطة تغذية."
msgstr ""
"የወገብ አከርካሪዎች በግልጽ ይዳሰሳሉ ግን ጠርዞቻቸው ከደረጃ 1 ያነሰ ስለታም ናቸው፣ በቀላል ግፊት የጎድን "
"አጥንቶች በቀላሉ ይሰማሉ። የተሻለ የመመገቢያ ዕቅድ ያስፈልጋል።"

#: app/health/health_service.py:292
msgid "معتدل (مثالي)"
msgstr "መካከለኛ (ተስማሚ)"

#: app/health/health_service.py:293
msgid ""
"الفقرات محسوسة بضغط متوسط باليد لكن ناعمة الحواف، الأضلاع تُحس بضغط لكن "
"ما تُرى بالعين. الوضع المستهدف لمعظم مراحل الإنتاج."
msgstr ""
"አከርካሪዎች በመካከለኛ የእጅ ግፊት ይሰማሉ ግን ለስላሳ ጠርዝ ያላቸው፣ የጎድን አጥንቶች በግፊት ይሰማሉ ግን "
"በዓይን አይታዩም። ለአብዛኞቹ የምርት ደረጃዎች የታለመ ሁኔታ።"

#: app/health/health_service.py:296
msgid "ممتلئ"
msgstr "የተሞላ"

#: app/health/health_service.py:297
msgid ""
"صعب تحسّس الفقرات إلا بضغط واضح، طبقة دهن ملحوظة فوق الأضلاع والقطنية. "
"مقبول للحوامل بالثلث الأخير، مراقبة لباقي الحالات."
msgstr ""
"ያለ ግልጽ ግፊት አከርካሪዎችን መዳሰስ ከባድ ነው፣ በጎድን አጥንቶች እና ወገብ ላይ የሚታይ የስብ ንብርብር። "
"በመጨረሻው ሶስተኛ ለነፍሰ ጡር ተቀባይነት ያለው፣ ለቀሩት ክትትል።"

#: app/health/health_service.py:300
msgid "سمين جداً"
msgstr "በጣም ወፍራም"

#: app/health/health_service.py:301
msgid ""
"ما تُحس الفقرات ولا الأضلاع إطلاقاً تحت طبقة دهن سميكة، شكل الظهر مستوٍ "
"أو مقبَّب. خطر على الولادة والحركة — يحتاج تعديل تغذية."
msgstr ""
"በወፍራም የስብ ንብርብር ስር አከርካሪም ሆነ የጎድን አጥንት በጭራሽ አይሰማም፣ የጀርባ ቅርጽ ጠፍጣፋ ወይም "
"የተጠጋጋ ነው። ለወሊድ እና እንቅስቃሴ አደጋ — የመመገቢያ ማስተካከያ ያስፈልጋል።"

#: app/health/health_service.py:360
#, python-format
msgid ""
"اخترت دواء (\"%(name)s\") بدون تحديد الكمية المستخدمة — لازم تحدد الجرعة "
"عشان يصح حساب التكلفة وخصم المخزون."
msgstr ""
"መድሃኒት (\"%(name)s\") መርጠዋል ያለ ጥቅም ላይ የዋለውን መጠን ሳይገልጹ — ወጪውና የክምችት ቅናሽ "
"በትክክል እንዲሰላ መጠኑን መግለጽ አለብዎት።"

#: app/health/health_service.py:491
msgid "منخفضة عن الطبيعي"
msgstr "ከመደበኛው በታች"

#: app/health/health_service.py:492
msgid "مرتفعة عن الطبيعي (حمى محتملة)"
msgstr "ከመደበኛው በላይ (ትኩሳት ሊሆን ይችላል)"

#: app/health/health_service.py:493
msgid "ضمن النطاق الطبيعي"
msgstr "በመደበኛ ክልል ውስጥ"

#: app/health/health_service.py:708
#, python-format
msgid "🚨 حالة طوارئ — الرأس %(no)s"
msgstr "🚨 አደጋ — እንስሳ %(no)s"

#: app/health/routes.py:71
msgid "تم إنجاز المهمة المرتبطة تلقائياً، وجُدولت مهمة متابعة إعادة وزن."
msgstr "የተያያዘው ተግባር በራስ-ሰር ተጠናቅቋል፣ የክብደት መከታተያ ተግባርም ተይዞልታል።"

#: app/health/routes.py:84
#, python-format
msgid "%(msg)s اكتب سبب التجاوز بالحقل المخصص لو متأكد من الحاجة للتكرار."
msgstr "%(msg)s እርግጠኛ ከሆኑ የመተላለፊያ ምክንያቱን በተዘጋጀው መስክ ይጻፉ።"

#: app/health/routes.py:181
msgid "ارفع صورة أولاً"
msgstr "መጀመሪያ ምስል ይስቀሉ"

#: app/health/routes.py:197
msgid ""
"تعذّر تحليل الصورة — تأكد إن مفتاح الذكاء الاصطناعي مفعَّل والصورة واضحة،"
" وعبّي البيانات يدوياً."
msgstr "ምስሉን መተንተን አልተቻለም — የAI ቁልፍ መንቃቱን እና ምስሉ ግልጽ መሆኑን ያረጋግጡ፣ መረጃውን በእጅ ይሙሉ።"

#: app/health/routes.py:202
