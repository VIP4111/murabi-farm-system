msgid "إجهاض"
msgstr "Abortion"

#: app/templates/repro/pregnancies_list.html:25
msgid "تأكيد الحمل"
msgstr "Confirm pregnancy"

#: app/templates/repro/pregnancies_list.html:30
#, python-format
