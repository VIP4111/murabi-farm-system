msgstr "Start"

#: app/templates/team/_my_tasks_rows.html:27
#: app/templates/team/worker_report_form.html:43
msgid "إنجاز / تعذّر ←"
msgstr "Complete / Fail ←"

#: app/templates/team/_my_tasks_rows.html:32
msgid "ما عندك مهام حالياً."
msgstr "You have no tasks right now."

#: app/templates/team/_report_widgets.html:20
msgid "الجنس:"
msgstr "Gender:"

#: app/templates/team/_report_widgets.html:20
msgid "العمر:"
msgstr "Age:"

#: app/templates/team/_report_widgets.html:21
